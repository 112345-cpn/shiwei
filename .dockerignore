# Docker 构建忽略文件
# 类似 .gitignore，加速构建，减小镜像

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# 构建产物
target/
build/
out/
*.class
*.jar
*.war
*.ear

# 日志
logs/
*.log
*.log.*

# Git
.git/
.gitignore
.gitattributes

# 文档（运行时不需要）
README.md
LICENSE
docs/

# Docker 自身
Dockerfile
.dockerignore
docker-compose*.yml

# 环境变量
.env
.env.local
*.env

# 测试
src/test/
**/test/
**/*Test.java
**/*Tests.java

# 上传文件
upload/
uploads/

# 覆盖率报告
jacoco/
coverage/
*.html

# ---------------------------------------------------------------
# 以下几项是「项目里存在、但构建后端镜像时完全用不到」的东西。
# 不加进来 build 时会把它们整个传给 docker daemon，白白多传几百 MB：
#   nginx-1.18.0/  Windows 版 nginx 发行包（含 nginx.exe）
#   web/           前端静态文件，由 web 容器单独挂载，不进后端镜像
#   tools/         压测与验证脚本
# ---------------------------------------------------------------
nginx-1.18.0/
web/
tools/
cp.txt
build.log
FIXES*.md

