# ===============================================
# 拾味 HM-DianPing 环境变量示例
#
#   用 Docker 一键启动：cp .env.example .env，改密码后 docker compose up -d --build
#   在宿主机直跑：     同样读这份文件（start-local.ps1 会加载）
#
# .env 已被 .gitignore / .dockerignore 排除，不会进仓库也不会进镜像。
# 不改也能跑——下面前缀 [Docker] 的项都写了代码里的默认值。
# ===============================================

# ========== 端口 ==========
# [Docker] 前端页面端口，浏览器打开 http://localhost:8080
WEB_PORT=8080
# [Docker] 后端直连端口（调试 / 压测用，正常看页面不走这个）
SERVER_PORT=8081
DB_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
# [Docker] RabbitMQ 管理台 http://localhost:15672
RABBITMQ_MGMT_PORT=15672
# [Docker] Sentinel 控制台，只在 docker compose --profile monitor 时启动
SENTINEL_PORT=8858

# ========== 数据库 ==========
# 容器内固定是服务名 mysql，直跑宿主机时才是 localhost
DB_HOST=localhost
DB_NAME=hmdp
DB_USERNAME=root
DB_PASSWORD=hmdp123456

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_DB=0

# ========== RabbitMQ ==========
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ========== 运行环境 ==========
# prod：验证码绝不回传前端（对外部署必须用这个）
# dev ：验证码回传前端，本地点登录方便，但绝不能对外
SPRING_PROFILES_ACTIVE=prod

# ========== JWT ==========
JWT_SECRET=please-generate-a-strong-random-secret-key

# ========== 日志 ==========
LOG_PATH=./logs
LOG_FILE_NAME=hmdp
